PORT=3000
DATABASE_URL=postgres://billing:billing@localhost:5432/billing

# Platform token for POST /v1/merchants. Use a long random value.
ADMIN_TOKEN=change-me-admin-token

# "true" allows http:// and private-network webhook URLs. Development only.
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_POLL_MS=5000
WEBHOOK_TIMEOUT_MS=10000
